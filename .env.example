# Copy to goip/.env. Values below are placeholders. Never commit real keys.

# Local operator token for the GOIP API. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GOIP_API_TOKEN=replace-with-a-long-random-token

# Bind on loopback. Do not expose this API on a public interface without authentication review.
GOIP_BIND_HOST=127.0.0.1
GOIP_PORT=8001

# postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/goip
GOIP_DATABASE_URL=postgresql+psycopg://goip:YOUR_PASSWORD@127.0.0.1:5433/goip
POSTGRES_PASSWORD=

# OpenRouter. One key, assigned to agent roles in config/runtime.json.
OPENROUTER_API_KEY=

# Telegram Bot API. The bot only accepts TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Crawl4AI Cloud. https://api.crawl4ai.com
CRAWL4AI_API_KEY=
CRAWL4AI_BASE_URL=https://api.crawl4ai.com

# Switch Agent Protocol on the bundled Switch Console agent port.
# This Console build serves the gateway at ${SWITCH_BASE_URL}/gateway.
# Port 50989 is unused unless a separate gateway process is started.
SWITCH_BASE_URL=http://127.0.0.1:50990
SWITCH_GATEWAY_URL=http://127.0.0.1:50990/gateway
SWITCH_REGISTRATION_KEY=
# Optional path to a Switch Console switch-core.env. Used only when
# SWITCH_REGISTRATION_KEY is empty. The file is read locally and never logged.
SWITCH_ENV_FILE=

# Comma-separated publisher domains that are sources, not client companies.
# Leave empty to use the built-in list.
GOIP_SCHEDULER_ENABLED=true
GOIP_SWITCH_ENABLED=true
GOIP_TELEGRAM_POLLING=true

# LangSmith tracing (optional). Prompts are PII-scrubbed before upload.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=

# Opt-in, off by default. Makes the WHOLE process trust the OS certificate store (for a TLS-inspecting
# corporate proxy). Anyone who controls a CA in that store can then read the Telegram, OpenRouter and
# LangSmith traffic. Enable only on a machine and network you trust.
GOIP_USE_SYSTEM_CERTS=
# Use the LangGraph orchestrator (default true). false restores the legacy chat-driven pipeline.
GOIP_GRAPH_ENABLED=

# Comma-separated Switch usernames allowed to approve/reject leads from the room. Empty = any room member.
GOIP_ROOM_APPROVERS=
